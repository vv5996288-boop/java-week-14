<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<html>
<head>
 <title>JSTL Function Tags Demo</title>
</head>
<body>
<h2>JSTL Function Tags Example</h2>
<%
 String name = "Java Server Pages";
%>
<c:set var="text" value="<%= name %>" />
<h3>Original Text:</h3>
<c:out value="${text}" />
<br><br>
<!-- Length -->
Length of string:
${fn:length(text)}
<br><br>
<!-- Uppercase -->
Uppercase:
${fn:toUpperCase(text)}
<br><br>
<!-- Lowercase -->
Lowercase:
${fn:toLowerCase(text)}
<br><br>
<!-- Substring -->
Substring (0 to 4):
${fn:substring(text, 0, 4)}
<br><br>
<!-- Contains -->
Contains "Server":
${fn:contains(text, "Server")}
</body>
</html>
